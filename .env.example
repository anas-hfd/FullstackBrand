# FullstackBrand Environment Variables Template

# Database URL
DATABASE_URL="file:./dev.db"

# Target Inquiry Email (Where lead submissions will be delivered)
TARGET_EMAIL="contact@fullstackbrand.co"

# Recommended for Cloudflare Workers & Pages: Resend HTTP API
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="FullstackBrand Leads <onboarding@resend.dev>"

# Alternative: SMTP Settings for Nodemailer (Node.js environments)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
