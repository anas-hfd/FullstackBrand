# FullstackBrand Environment Variables Template

# Database URL
DATABASE_URL="file:./dev.db"

# Target Inquiry Email (Where lead submissions will be delivered)
TARGET_EMAIL="your-email@example.com"

# SMTP Settings for Nodemailer
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
