# FullstackBrand Environment Variables Template

# AI chat assistant (server-side ONLY — never expose with NEXT_PUBLIC_)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Database URL
DATABASE_URL="file:./dev.db"

# Target Inquiry Email (Where lead submissions will be delivered)
TARGET_EMAIL="contact@fullstackbrand.co"

# Recommended for Cloudflare Workers & Pages: Brevo HTTP API (300 free emails/day)
BREVO_API_KEY="xkeysib-123456789..."

# Alternative: Resend HTTP API
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="FullstackBrand Leads <onboarding@resend.dev>"

